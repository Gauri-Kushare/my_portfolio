# ==============================================================================
# GAURI KUSHARE PORTFOLIO + SECURE ADMIN CMS — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `.env` (which is git-ignored) and fill in your values.
# Never commit real secret keys or `.env` files to GitHub.

# 1. Server-Side Admin Session HMAC Secret (Required for production security)
# Generate a strong random string (e.g. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=replace-with-a-long-random-hmac-secret-string

# 2. Optional Email OTP Delivery via Resend (https://resend.com)
# When configured, 6-digit login codes for gaurikushare18@gmail.com are emailed
# automatically. When omitted in local dev, the server displays the generated
# OTP code in the login prompt for immediate local verification.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Portfolio Admin <onboarding@resend.dev>"
ADMIN_OTP_STRICT_EMAIL=false

# 3. Optional Supabase PostgreSQL + Storage Integration
# Run `supabase/schema.sql` in your Supabase SQL Editor to create the tables,
# Row Level Security (RLS) policies, and `portfolio-media` storage bucket.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 4. Optional Custom Server Database File Path (defaults to ./data/portfolio-cms.json)
PORTFOLIO_DB_PATH=

